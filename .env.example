# Required — OpenRouter inference API (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# (a GROQ_API_KEY name is also accepted for backward compatibility)

# Optional — LangSmith tracing (set LANGSMITH_TRACING=true to enable)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Neo4j graph store (Neo4j Desktop: start your DBMS, then fill these in)
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Optional overrides (defaults live in config.py)
# LLM_MODEL=stealth/ox-alpha
# N_RESULTS=5
# MAX_LLM_CALLS=25
# INDEX_DIR=C:/Users/you/AppData/Local/self-rag/index
